# StockWise Environment Configuration

# ------------------------------------------------------------------------------
# Supabase Authentication & Private Cloud Database (PostgreSQL with RLS)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Settings -> API -> Project URL & anon/public key.
# Never expose the service_role key to the frontend client!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# Optional Market Data API Key
# ------------------------------------------------------------------------------
VITE_MARKET_API_KEY=
VITE_MARKET_API_PROVIDER=finnhub # Options: finnhub, alphavantage, mock

# Default Market Configuration (Indian NSE/BSE)
VITE_DEFAULT_EXCHANGE=NSE
VITE_DEFAULT_CURRENCY=INR

# Application Port
PORT=3000
